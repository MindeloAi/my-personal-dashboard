# Copy this file to .env.local and fill in real values.
# .env.local is gitignored.

# ── Supabase / Postgres (the dashboard's database) ──
# Two connection strings, both from Supabase → Project Settings → Database.
#
# DATABASE_URL — TRANSACTION pooler, port 6543. Used by the app at runtime.
# DIRECT_URL   — SESSION pooler, port 5432. Used by the migration scripts,
#                because DDL and multi-statement queries don't work on the
#                transaction pooler.
#
# Use the *pooler* host (aws-N-<region>.pooler.supabase.com) for BOTH.
# Do NOT use db.<ref>.supabase.co — it is IPv6-only on the free tier.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ── Airtable (LEGACY — migration scripts only) ──
# The app no longer reads Airtable; these are used by `npm run db:export` and
# `npm run db:verify` to snapshot and cross-check the old base. They can be
# deleted once Airtable is retired in Pass 2.
# Personal Access Token from https://airtable.com/create/tokens
# Required scopes: data.records:read, data.records:write, schema.bases:read
AIRTABLE_API_KEY=pat_replace_me

# Base ID for the "Business Dashboard" base. Find it under
# https://airtable.com/api or the URL of your base (starts with "app...").
AIRTABLE_BASE_ID=app_replace_me

# ── Dashboard auth ──
# Shared passcode for the login gate. Currently UNUSED: the gate was removed
# again in commit c138d1b because the value set in Vercel production is not
# recoverable (it is marked sensitive, so `vercel env pull` returns it empty).
# src/lib/auth.ts and src/app/login/page.tsx are still in the repo — to
# re-enable, set a passcode you know here AND in Vercel, then revert c138d1b.
DASHBOARD_PASSCODE=replace_me

# NOTE: GITHUB_TOKEN and ANTHROPIC_API_KEY are no longer used. The Dev hub and
# the in-app automations were removed, along with the octokit and
# @anthropic-ai/sdk dependencies.

# ── Optional: Telegram (invoice review) ──
# TELEGRAM_BOT_TOKEN=replace_me
# TELEGRAM_CHAT_ID=replace_me

# ── Optional: Agency identity (invoice header) ──
# AGENCY_NAME=Your Agency
# AGENCY_BUSINESS_ID=
# AGENCY_BUSINESS_NUMBER=
# AGENCY_PHONE=
# AGENCY_ADDRESS=
# AGENCY_PAYMENT_TERMS=Net 14
# AGENCY_PAYMENT_DUE_DAYS=14

# ── Optional: Clerk auth (currently unused; re-enable when wiring auth) ──
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# CLERK_SECRET_KEY=sk_test_replace_me
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
# NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ── Optional: Resend (Phase 5 — invoice email) ──
# RESEND_API_KEY=re_replace_me
